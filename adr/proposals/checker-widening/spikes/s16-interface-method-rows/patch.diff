+            file_path: filePath,
+            start_line: mStart,
+            end_line: mEnd,
+            content: expandContent(lines, mStart, mEnd, contextLines),
+            chunk_type: 'method',
+            symbol_name: `${name}.${methodName}`,
+            parent_symbol: name,
+            is_exported: isExported,
+            language,
+            file_mtime: fileMtime,
+            declaration_hash: declHashOf(member, src),
