+      // SPIKE s16: a row for each method of the interface, named as a class's are.
+      const interfaceBody = node.childForFieldName('body');
+      if (interfaceBody !== null && name !== null) {
+        const seen = new Set<string>();
+        for (const member of nodeNamedChildren(interfaceBody)) {
+          if (nodeType(member) !== 'method_signature') continue;
+          const methodName = member.childForFieldName('name')?.text ?? null;
+          // An overload is one member. A member on the interface's own line would
+          // share the interface's chunk id.
+          if (methodName === null || seen.has(methodName) || nodeStartLine(member) === startLine) continue;
