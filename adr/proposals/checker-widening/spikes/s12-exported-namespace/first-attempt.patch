+/**
+ * The file a namespace import of `fileId` binds as `name`, when `name` is no
+ * symbol of the file: no declaration, and no name it re-exports. Whether the
+ * file exports the namespace is not stored; an import of `name` from it says
+ * so. A file that exports something else under the name has a row for it, and
+ * that is not the namespace.
+ */
+async function moduleOfExportedNamespace(db: Db, fileId: number, name: string): Promise<string | null> {
+  const row = await db.selectFrom('symbols').select('id').where('file_id', '=', fileId).where('name', '=', name).executeTakeFirst();
+  if (row !== undefined) return null;
+  const imports = await db
+    .selectFrom('imports')
+    .select(['aliases', 'resolved_path'])
+    .where('file_id', '=', fileId)
+    .where('aliases', 'is not', null)
+    .orderBy('module', 'asc')
+    .execute();
+  for (const imp of imports) {
+    if (imp.aliases === null) continue;
+    const aliases: unknown = JSON.parse(imp.aliases);
+    if (typeof aliases === 'object' && aliases !== null && Object.hasOwn(aliases, name) && Reflect.get(aliases, name) === WHOLE_MODULE) {
+      return imp.resolved_path;
+    }
+  }
+  return null;
+}
+
 /** Bounded hop count for chained named re-exports (barrel re-exporting a barrel). */
 const MAX_RE_EXPORT_HOPS = 5;
 
